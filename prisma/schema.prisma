generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   // misal: "Makanan", "Minuman", "Dessert"
  price       Float
  image       String?
  description String?
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Table {
  id       Int       @id @default(autoincrement())
  number   Int    @unique // misal: "A1", "B2"
  capacity Int
  status   Boolean   @default(true) // true = tersedia
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id         Int           @id @default(autoincrement())
  user       User          @relation(fields: [userId], references: [id])
  userId     Int
  table      Table         @relation(fields: [tableId], references: [id])
  tableId    Int
  paymentProofUrl String?
  date       DateTime
  time       String        // format "HH:mm"
  guestCount Int
  status     BookingStatus @default(PENDING)
  transaction Transaction?
  orders     Order[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Order {
  id        Int         @id @default(autoincrement())
  booking   Booking     @relation(fields: [bookingId], references: [id])
  bookingId Int
  menu      Menu        @relation(fields: [menuId], references: [id])
  menuId    Int
  quantity  Int
  note      String?
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model Transaction {
  id            Int           @id @default(autoincrement())
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingId     Int           @unique
  total         Float
   paymentProofUrl String?
  paymentMethod PaymentMethod @default(CASH)
  status        PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
}
